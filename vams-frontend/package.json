{
  "name": "vams-frontend",
  "private": true,
  "version": "1.0.0",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','release'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});}catch(e){console.warn('clean skipped',d,e.code||e.message);}})\"",
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "dist": "npm run clean && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.vertihub.vams",
    "productName": "VAMS",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.js"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}

