{
  "name": "vams-frontend",
  "private": true,
  "version": "1.0.0",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','build','release/latest','C:/Temp/vams-release'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});}catch(e){console.warn('clean skipped',d,e.code||e.message);}})\"",
    "dev": "vite",
    "build": "vite build",
    "electron-build": "npm run dist",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "cross-env NODE_ENV=development ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config.directories.output=C:/Temp/vams-release && node -e \"const fs=require('fs');const path=require('path');const src='C:/Temp/vams-release';const dst='release/latest';fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst,{recursive:true});for(const name of fs.readdirSync(src)){fs.cpSync(path.join(src,name),path.join(dst,name),{recursive:true});}\""
  },
  "build": {
    "appId": "com.vams.app",
    "productName": "VAMS",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "artifactName": "${productName} Setup.${ext}",
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ]
  },
  "dependencies": {
    "axios": "^1.6.2",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
